<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <PackageId>lyFonts</PackageId>
    <Version>0.1.3</Version>
    <Authors>lysis evolutions</Authors>
    <Description>lysis fonts (lyFonts) is a port of FreeType to Cosmos and can be easily used within Cosmos-based operating systems.</Description>
    <PackageLicenseExpression>BSD-3-Clause</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Cosmos.Kernel.System" Version="3.0.99" />
  </ItemGroup>

  <!-- MSBuild wiring -->
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\build\lyFonts.targets" Pack="true" PackagePath="build\" />
    <None Include="..\..\build\lyFonts.targets" Pack="true" PackagePath="buildTransitive\" />
  </ItemGroup>

  <!-- Native C files and headers -->
  <ItemGroup>
    <None Include="..\native\ft_*.c" Pack="true" PackagePath="native\" />
    <None Include="..\native\freetype-config\**\*" Pack="true" PackagePath="native\freetype-config\" />
    <None Include="..\native\freetype\**\*" Exclude="..\native\freetype\.git;..\native\freetype\.git\**\*" Pack="true" PackagePath="native\freetype\" />
  </ItemGroup>

</Project>
